# Base URL for the main backend API (no trailing slash preferred)
REACT_APP_API_BASE_URL=https://api.weeklyinsight.example.com/api/v1

# Site URL for auth redirect flows (e.g., Supabase)
REACT_APP_SITE_URL=http://localhost:3000

# Optional: If services are split across different hosts, uncomment and set these:
# REACT_APP_NOTIFICATIONS_API_BASE_URL=https://notifications.weeklyinsight.example.com/api/v1
# REACT_APP_AI_API_BASE_URL=https://ai.weeklyinsight.example.com/api/v1
# REACT_APP_EXPORT_API_BASE_URL=https://export.weeklyinsight.example.com/api/v1
