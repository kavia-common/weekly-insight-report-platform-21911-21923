# Public environment variables for the unified Reports Frontend
# Copy this file to .env and set appropriate values for your environment.

# Base URL for backend API (e.g., NotificationService or other services)
REACT_APP_API_BASE_URL=https://reports.digitalt3.com/api/v1

# Site URL used for auth redirects (e.g., Supabase)
REACT_APP_SITE_URL=http://localhost:3000
